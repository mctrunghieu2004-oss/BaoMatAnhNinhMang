@startuml
' So do 2: DFD muc 1 co trust boundary
title SecureGrade - DFD muc 1 (trust boundary)

skinparam componentStyle rectangle

actor "SV" as sv
actor "GV" as gv
actor "Admin" as ad

package "Trust boundary 1: Internet (KHONG tin)" {
  component "Trinh duyet / Postman / curl" as client
}

package "Trust boundary 2: DMZ (loc cu phap)" {
  component "P0 - WAF\nloc payload da biet" as p0
}

package "Trust boundary 3: App (kiem chung nghiep vu)" {
  component "P1 - Xac thuc\npassword + TOTP + session" as p1
  component "P2 - Phan quyen\nRBAC + ownership" as p2
  component "P3 - Nghiep vu diem\nvalidate + step-up OTP" as p3
  component "P4 - Audit + Detect\nhash-chain, rule tuong quan" as p4
  component "P5 - Phan ung su co\nrevoke / reset MFA / unlock" as p5
}

package "Trust boundary 4: Data (chi app_user truy cap)" {
  database "D1 users" as d1
  database "D2 sessions" as d2
  database "D3 courses/enrollments" as d3
  database "D4 grades" as d4
  database "D5 audit_log (append-only)" as d5
}

sv --> client
gv --> client
ad --> client
client --> p0 : "request + cookie sg_token"
p0 --> p1 : "request da loc"
p1 --> d1 : "doc hash, mfa_secret, trang thai khoa"
p1 --> d2 : "tao / thu hoi session"
p1 --> p2 : "req.user (role doc tu DB)"
p2 --> d3 : "kiem tra ownership"
p2 --> p3
p3 --> d4 : "UPDATE / INSERT diem"
p3 --> p4
p1 --> p4
p2 --> p4
p4 --> d5 : "INSERT (khong UPDATE, khong DELETE)"
p4 --> d4 : "doi chieu diem voi log"
ad --> p5
p5 --> d1
p5 --> d2

note right of p0
  Du lieu di qua day van bi coi la
  KHONG DANG TIN: WAF chi loc cu phap,
  khong hieu nghiep vu.
end note
@enduml
