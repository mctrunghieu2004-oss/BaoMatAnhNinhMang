@startuml
' So do 4: Sequence dang nhap + MFA
title Luong dang nhap: mat khau -> token pre-MFA -> OTP -> token day du

actor "Nguoi dung" as u
participant "WAF" as w
participant "app /api/auth" as a
participant "sessions" as s
participant "users" as usr
participant "audit_log" as log

u -> w : POST /api/auth/login {username, password}
w -> a : da loc payload (CRS)
a -> a : rate limit 10/15 phut/IP
a -> usr : SELECT * WHERE username = $1
a -> a : bcrypt.compare (DUMMY_HASH neu khong co user)
alt locked_until > now()
  a -> log : LOGIN_WHILE_LOCKED (WARN)
  a --> u : 423 ACCOUNT_LOCKED
else sai mat khau
  a -> usr : failed_attempts + 1, khoa khi >= 5
  a -> log : LOGIN_FAIL / ACCOUNT_LOCKED
  a --> u : 401 INVALID_CREDENTIALS (cung 1 thong bao)
else dung mat khau
  a -> usr : failed_attempts = 0
  a -> s : INSERT session (mfa_verified = false, TTL 300s)\nfingerprint = SHA256(UA + IP)
  a -> log : LOGIN_PASSWORD_OK (INFO)
  a --> u : 200 {next: MFA_ENROLL | MFA_VERIFY}\nSet-Cookie sg_token (HttpOnly, SameSite=Strict)
end

group Lan dau: MFA_ENROLL
  u -> a : POST /api/auth/mfa/setup
  a -> usr : UPDATE mfa_secret = generateSecret()
  a --> u : 200 {qr: data URL}
  u -> u : quet QR bang app authenticator
  u -> a : POST /api/auth/mfa/enable {otp}
end

group Lan sau: MFA_VERIFY
  u -> a : POST /api/auth/mfa/verify {otp}
end

a -> a : checkOtp(): dinh dang 6 so -> chong replay (last_otp, 90s) -> verify TOTP
alt OTP sai
  a -> usr : mfa_failed + 1, khoa khi >= 3
  a -> log : MFA_FAIL_INVALID / MFA_FAIL_THRESHOLD (HIGH)
  a -> s : revoke session (MFA_FAIL_THRESHOLD)
  a --> u : 401 OTP_INVALID hoac 423 ACCOUNT_LOCKED
else OTP dung
  a -> usr : last_otp = otp, mfa_failed = 0
  a -> s : revoke session cu (UPGRADED)  <- chong session fixation
  a -> s : INSERT session moi (mfa_verified = true, TTL 900s)
  a -> log : LOGIN_SUCCESS / MFA_ENROLLED
  a --> u : 200 {role} + cookie moi
end
@enduml
