@startuml
' Sơ đồ 2: DFD mức 1 có trust boundary
' Bố cục khi vẽ lại: 4 dải ngang xếp từ trên xuống, mỗi dải là một trust boundary
' (vẽ bằng khung nét đứt trong draw.io). Dữ liệu chảy từ trên xuống dưới.
' ---- Bảng màu quy ước (dùng lại đúng các mã này khi vẽ trong draw.io) ----
'   #2E5C8A xanh đậm  — tiêu đề, viền khối chính
'   #DCE6F1 xanh nhạt — nền khối hợp lệ
'   #C0392B đỏ        — luồng bị chặn, tác nhân đe dọa
'   #FADBD8 đỏ nhạt   — nền misuse case / nhánh từ chối
'   #F4F6F8 xám nhạt  — nền zone
'   #7F8C8D xám       — ghi chú
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #44546A
skinparam ArrowFontSize 11
skinparam TitleFontSize 16
skinparam TitleFontColor #2E5C8A
skinparam NoteBackgroundColor #FFF9E6
skinparam NoteBorderColor #D4AC0D
skinparam NoteFontSize 11
title Sơ đồ 2 — DFD mức 1 với trust boundary

skinparam componentStyle rectangle
skinparam package {
  BackgroundColor #F4F6F8
  BorderColor #2E5C8A
  BorderThickness 1
}
skinparam component {
  BackgroundColor #DCE6F1
  BorderColor #2E5C8A
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #2E5C8A
}

actor "Sinh viên" as sv
actor "Giảng viên" as gv
actor "Admin" as ad

package "Trust boundary 1 — Internet (KHÔNG tin)" {
  component "Trình duyệt / Postman / curl" as client
}

package "Trust boundary 2 — DMZ (lọc cú pháp)" {
  component "P0 — WAF\nlọc payload đã biết theo CRS" as p0
}

package "Trust boundary 3 — App (kiểm chứng nghiệp vụ)" {
  component "P1 — Xác thực\nmật khẩu + TOTP + session" as p1
  component "P2 — Phân quyền\nRBAC + ownership" as p2
  component "P3 — Nghiệp vụ điểm\nvalidate + step-up OTP" as p3
  component "P4 — Audit + Detect\nhash-chain, rule tương quan 60s" as p4
  component "P5 — Phản ứng sự cố\nrevoke / reset MFA / unlock" as p5
}

package "Trust boundary 4 — Data (chỉ app_user truy cập)" {
  database "D1 users" as d1
  database "D2 sessions" as d2
  database "D3 courses + enrollments" as d3
  database "D4 grades" as d4
  database "D5 audit_log\n(append-only)" as d5
}

sv --> client
gv --> client
ad --> client
client --> p0 : "request + cookie sg_token"
p0 --> p1 : "request đã lọc"
p1 --> d1 : "đọc password_hash, mfa_secret, trạng thái khoá"
p1 --> d2 : "tạo / thu hồi session"
p1 --> p2 : "req.user — role đọc từ DB"
p2 --> d3 : "kiểm tra ownership"
p2 --> p3
p3 --> d4 : "UPDATE / INSERT điểm"
p3 --> p4
p1 --> p4
p2 --> p4
p4 --> d5 : "INSERT (không UPDATE, không DELETE)"
p4 --> d4 : "đối chiếu điểm với log"
ad --> p5
p5 --> d1
p5 --> d2

note right of p0
  Dữ liệu đi qua đây **vẫn bị coi là không đáng tin**:
  WAF chỉ lọc cú pháp, không hiểu nghiệp vụ.
  Mọi kiểm chứng có ý nghĩa nằm ở P1–P3.
end note
@enduml
