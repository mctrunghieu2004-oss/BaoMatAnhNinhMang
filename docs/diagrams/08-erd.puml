@startuml
' Sơ đồ 8: ERD — 6 bảng
' Bố cục khi vẽ lại: users ở giữa (mọi bảng đều trỏ về nó).
' courses - enrollments - grades xếp thành một hàng bên phải,
' sessions và audit_log nằm bên trái.
' Ký hiệu quan hệ: ||--o{ = một-nhiều, ||--o| = một-một (tùy chọn).
' ---- Bảng màu quy ước (dùng lại đúng các mã này khi vẽ trong draw.io) ----
'   #2E5C8A xanh đậm  — tiêu đề, viền khối chính
'   #DCE6F1 xanh nhạt — nền khối hợp lệ
'   #C0392B đỏ        — luồng bị chặn, tác nhân đe dọa
'   #FADBD8 đỏ nhạt   — nền misuse case / nhánh từ chối
'   #F4F6F8 xám nhạt  — nền zone
'   #7F8C8D xám       — ghi chú
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #44546A
skinparam ArrowFontSize 11
skinparam TitleFontSize 16
skinparam TitleFontColor #2E5C8A
skinparam NoteBackgroundColor #FFF9E6
skinparam NoteBorderColor #D4AC0D
skinparam NoteFontSize 11
hide circle
title Sơ đồ 8 — ERD (6 bảng)

skinparam entity {
  BackgroundColor #DCE6F1
  BorderColor #2E5C8A
  BackgroundColor<<append>> #FFF2CC
  BorderColor<<append>> #D4AC0D
}

entity "users" as users {
  * id : serial <<PK>>
  --
  username : varchar(50) <<unique>>
  full_name : varchar(100)
  role : STUDENT | LECTURER | ADMIN
  password_hash : text — bcrypt cost 12
  mfa_secret : text — base32 TOTP
  mfa_enabled : boolean
  last_otp : varchar(6) — chống replay OTP
  last_otp_at : timestamptz
  failed_attempts : int
  mfa_failed : int
  locked_until : timestamptz
  is_active : boolean
}

entity "courses" as courses {
  * id : serial <<PK>>
  --
  code : varchar(20) <<unique>>
  name : varchar(100)
  lecturer_id : int <<FK users.id>>
}

entity "enrollments" as enrollments {
  * id : serial <<PK>>
  --
  course_id : int <<FK courses.id>>
  student_id : int <<FK users.id>>
  <<unique (course_id, student_id)>>
}

entity "grades" as grades {
  * enrollment_id : int <<PK, FK enrollments.id>>
  --
  score : numeric(4,2) — CHECK 0..10
  updated_by : int <<FK users.id>>
  updated_at : timestamptz
}

entity "sessions" as sessions {
  * id : uuid <<PK>>
  --
  user_id : int <<FK users.id>>
  fingerprint : char(64) — SHA-256(UA + IP)
  mfa_verified : boolean
  expires_at : timestamptz
  revoked_at : timestamptz
  revoke_reason : varchar(40)
}

entity "audit_log" as audit <<append>> {
  * id : bigserial <<PK>>
  --
  ts : timestamptz — app tự điền để đưa vào hash
  actor_id : int
  action : varchar(40)
  target : varchar(100)
  detail : **TEXT** — JSON nguyên văn, không dùng JSONB
  ip : varchar(64)
  severity : INFO | WARN | HIGH | CRITICAL
  prev_hash : char(64)
  hash : char(64)
}

users     ||--o{ courses     : "dạy"
users     ||--o{ enrollments : "học"
courses   ||--o{ enrollments
enrollments ||--o| grades
users     ||--o{ sessions
users     ||--o{ audit       : "actor"

note bottom of audit
  **Append-only**: app_user chỉ có SELECT + INSERT,
  không có UPDATE và không có DELETE.
  hash = SHA256(prev_hash | ts | actor_id | action |
                target | detail | ip | severity)
  Dùng TEXT thay vì JSONB vì JSONB sắp xếp lại thứ tự
  khoá khi đọc ra → hash tính lại sẽ khác → đứt chuỗi.
end note
@enduml
